{
  "name": "jira-desktop-app",
  "version": "2.1.0",
  "description": "Modern Jira Desktop App built with Electron",
  "main": "dist/main/main.js",
  "author": {
    "name": "JoshWay",
    "email": "developer@joshway.com"
  },
  "license": "ISC",
  "homepage": "https://opt.si",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder && npm run clean-blockmap",
    "dist:all": "electron-builder -mwl",
    "clean": "rimraf dist out",
    "clean-blockmap": "rm -f release/*.blockmap",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.joshway.jira-desktop",
    "productName": "Jira Desktop",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "publisherName": "JoshWay",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Network",
      "maintainer": "JoshWay <developer@joshway.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
